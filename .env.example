
# ============================================================
# SAS4 status integration
# Whole seconds, supported range 1..20. Existing deployments default to 4.
# Slower SAS servers may require a measured value such as 20.
# ============================================================
SAS4_STATUS_TIMEOUT_SECONDS=4

# ============================================================
# WhatsApp / OpenWA
# ============================================================
OPENWA_API_URL=http://192.168.0.75:2785/api
OPENWA_API_KEY=your_openwa_api_key_here
OPENWA_SESSION_ID=fb1c9887-0ded-4c1e-9045-f5a9c8961a3f

# ============================================================
# Telescope (Debug) — إطفاؤه على البرودكشن
# ============================================================
# TELESCOPE_ENABLED=false
