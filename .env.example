
# ============================================================
# SAS4 status integration
# Required private SAS4 transport configuration (no functional defaults).
SAS4_URL=
SAS4_USERNAME=
SAS4_PASSWORD=
SAS4_AES_KEY=
# Whole seconds, supported range 1..20. Existing deployments default to 4.
# Slower SAS servers may require a measured value such as 20.
# ============================================================
SAS4_STATUS_TIMEOUT_SECONDS=4

# ============================================================
# WhatsApp / OpenWA
# ============================================================
OPENWA_API_URL=http://192.168.0.75:2785/api
OPENWA_API_KEY=your_openwa_api_key_here
OPENWA_SESSION_ID=fb1c9887-0ded-4c1e-9045-f5a9c8961a3f

# ============================================================
# Zernio (Meta Cloud API) — optional
# Driver toggle handled by the dashboard (stored as WHATSAPP_DRIVER).
# Monthly reminders are MANUAL-ONLY and FAIL-CLOSED:
#   - ZERNIO_REMINDER_TEMPLATE  : Meta-approved reminder template name
#   - ZERNIO_MONTHLY_REMINDER_ENABLED: MUST be set to true for ANY monthly
#       reminder send (manual included) to be allowed. Leave unset/false to
#       keep monthly reminders completely disabled (recommended until you
#       explicitly want to send one).
# ============================================================
# WHATSAPP_DRIVER=zernio
# ZERNIO_API_KEY=
# ZERNIO_ACCOUNT_ID=
# ZERNIO_WABA_ID=
# ZERNIO_REMINDER_TEMPLATE=monthly_reminder_v1
# ZERNIO_MONTHLY_REMINDER_ENABLED=true

# ============================================================
# Telescope (Debug) — إطفاؤه على البرودكشن
# ============================================================
# TELESCOPE_ENABLED=false
